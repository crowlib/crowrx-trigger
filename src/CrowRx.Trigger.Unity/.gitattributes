# Normalize text to LF; leave detected binary files unchanged.
* text=auto eol=lf

# Source and package configuration
*.cs text eol=lf diff=csharp
*.asmdef text eol=lf
*.asmref text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.shader text eol=lf
*.shadergraph text eol=lf
*.shadersubgraph text eol=lf
*.hlsl text eol=lf
*.cginc text eol=lf
*.compute text eol=lf
*.uxml text eol=lf
*.uss text eol=lf
*.meta text eol=lf

# Some Unity assets can be binary; detect rather than force text.
*.unity text=auto eol=lf
*.prefab text=auto eol=lf
*.asset text=auto eol=lf
*.mat text=auto eol=lf
*.anim text=auto eol=lf
*.controller text=auto eol=lf
*.overrideController text=auto eol=lf
*.playable text=auto eol=lf
*.mask text=auto eol=lf

# Binary assets and distributables; no Git LFS setup is required.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bmp binary
*.tga binary
*.psd binary
*.exr binary
*.hdr binary
*.ico binary
*.wav binary
*.mp3 binary
*.ogg binary
*.aif binary
*.aiff binary
*.mp4 binary
*.mov binary
*.avi binary
*.fbx binary
*.blend binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.dll binary
*.pdb binary
*.mdb binary
*.nupkg binary
*.unitypackage binary
*.zip binary
*.7z binary
